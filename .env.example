# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for GitHub token storage (32-byte hex)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Remix session cookie secret
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Application URL (no trailing slash)
APP_URL=http://localhost:3000

# Draw.io export server URL (for converting .drawio to SVG)
# In Docker: http://drawio-export:8000
# Falls back to Puppeteer-based conversion if not set
DRAWIO_EXPORT_URL=
